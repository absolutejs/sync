{
	"name": "@absolutejs/sync",
	"version": "2.13.3",
	"description": "Lightweight reactive-push and write-behind-cache primitives for Elysia and the AbsoluteJS ecosystem — kill polling and keep a remote store off your hot path, without adopting a whole sync-engine backend.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/absolutejs/sync.git"
	},
	"homepage": "https://github.com/absolutejs/sync",
	"bugs": {
		"url": "https://github.com/absolutejs/sync/issues"
	},
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"license": "BSL-1.1",
	"author": "Alex Kahn",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./scheduled": {
			"types": "./dist/scheduled.d.ts",
			"import": "./dist/scheduled.js",
			"default": "./dist/scheduled.js"
		},
		"./write-behind-cache": {
			"types": "./dist/writeBehindCache.d.ts",
			"import": "./dist/writeBehindCache.js",
			"default": "./dist/writeBehindCache.js"
		},
		"./testing": {
			"types": "./dist/testing.d.ts",
			"import": "./dist/testing.js",
			"default": "./dist/testing.js"
		},
		"./code-mode": {
			"types": "./dist/codeMode.d.ts",
			"import": "./dist/codeMode.js",
			"default": "./dist/codeMode.js"
		},
		"./mcp": {
			"types": "./dist/mcp/index.d.ts",
			"import": "./dist/mcp/index.js",
			"default": "./dist/mcp/index.js"
		},
		"./client": {
			"types": "./dist/client/index.d.ts",
			"import": "./dist/client/index.js",
			"default": "./dist/client/index.js"
		},
		"./crdt": {
			"types": "./dist/crdt/index.d.ts",
			"import": "./dist/crdt/index.js",
			"default": "./dist/crdt/index.js"
		},
		"./drizzle": {
			"types": "./dist/adapters/drizzle/index.d.ts",
			"import": "./dist/adapters/drizzle/index.js",
			"default": "./dist/adapters/drizzle/index.js"
		},
		"./prisma": {
			"types": "./dist/adapters/prisma/index.d.ts",
			"import": "./dist/adapters/prisma/index.js",
			"default": "./dist/adapters/prisma/index.js"
		},
		"./engine": {
			"types": "./dist/engine/index.d.ts",
			"import": "./dist/engine/index.js",
			"default": "./dist/engine/index.js"
		},
		"./postgres": {
			"types": "./dist/adapters/postgres/index.d.ts",
			"import": "./dist/adapters/postgres/index.js",
			"default": "./dist/adapters/postgres/index.js"
		},
		"./mysql": {
			"types": "./dist/adapters/mysql/index.d.ts",
			"import": "./dist/adapters/mysql/index.js",
			"default": "./dist/adapters/mysql/index.js"
		},
		"./sqlite": {
			"types": "./dist/adapters/sqlite/index.d.ts",
			"import": "./dist/adapters/sqlite/index.js",
			"default": "./dist/adapters/sqlite/index.js"
		},
		"./tanstack-db": {
			"types": "./dist/adapters/tanstack-db/index.d.ts",
			"import": "./dist/adapters/tanstack-db/index.js",
			"default": "./dist/adapters/tanstack-db/index.js"
		},
		"./react": {
			"types": "./dist/react/index.d.ts",
			"import": "./dist/react/index.js",
			"default": "./dist/react/index.js"
		},
		"./vue": {
			"types": "./dist/vue/index.d.ts",
			"import": "./dist/vue/index.js",
			"default": "./dist/vue/index.js"
		},
		"./svelte": {
			"types": "./dist/svelte/index.d.ts",
			"import": "./dist/svelte/index.js",
			"default": "./dist/svelte/index.js"
		},
		"./angular": {
			"types": "./dist/angular/index.d.ts",
			"import": "./dist/angular/index.js",
			"default": "./dist/angular/index.js"
		},
		"./manifest": {
			"types": "./dist/manifest.d.ts",
			"import": "./dist/manifest.js",
			"default": "./dist/manifest.js"
		},
		"./manifest.json": "./dist/manifest.json",
		"./platform": {
			"types": "./dist/platform.d.ts",
			"import": "./dist/platform.js",
			"default": "./dist/platform.js"
		}
	},
	"absolutejs": {
		"manifestContract": 2,
		"runtimePeers": {
			"@absolutejs/isolated-jsc": {
				"artifactImports": [
					"@absolutejs/isolated-jsc"
				],
				"optional": true,
				"range": ">=0.12.2 <0.13.0",
				"tested": "0.12.2"
			},
			"@modelcontextprotocol/sdk": {
				"artifactImports": [
					"@modelcontextprotocol/sdk/server/mcp.js",
					"@modelcontextprotocol/sdk/server/stdio.js"
				],
				"optional": true,
				"range": ">=1.29.0 <2",
				"tested": "1.29.0"
			},
			"@angular/core": {
				"artifactImports": [
					"@angular/core"
				],
				"optional": true,
				"range": ">=21.2.18 <22",
				"tested": "21.2.18"
			},
			"@elysiajs/cron": {
				"artifactImports": [
					"@elysiajs/cron"
				],
				"optional": true,
				"range": ">=1.4.2 <2",
				"tested": "1.4.2"
			},
			"@tanstack/db": {
				"artifactImports": [],
				"optional": true,
				"range": ">=0.6.16 <0.7",
				"tested": "0.6.16"
			},
			"drizzle-orm": {
				"artifactImports": [
					"drizzle-orm"
				],
				"optional": true,
				"range": ">=1.0.0-rc.4 <2",
				"tested": "1.0.0-rc.4"
			},
			"elysia": {
				"artifactImports": [
					"elysia"
				],
				"optional": true,
				"range": ">=1.4.29 <2",
				"tested": "1.4.29"
			},
			"react": {
				"artifactImports": [
					"react"
				],
				"optional": true,
				"range": ">=19.2.8 <20",
				"tested": "19.2.8"
			},
			"svelte": {
				"artifactImports": [],
				"optional": true,
				"range": ">=5.56.7 <6",
				"tested": "5.56.7"
			},
			"vue": {
				"artifactImports": [
					"vue"
				],
				"optional": true,
				"range": ">=3.5.40 <4",
				"tested": "3.5.40"
			}
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "bun run scripts/build.ts",
		"config": "absolute config",
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"format": "prettier --write \"./**/*.{ts,json,md}\"",
		"release": "bun run format && bun run build && bun publish"
	},
	"keywords": [
		"absolutejs",
		"elysia",
		"reactive",
		"sse",
		"realtime",
		"write-behind",
		"cache",
		"sync",
		"drizzle",
		"prisma",
		"postgres",
		"mysql",
		"sqlite",
		"cdc",
		"react",
		"vue",
		"svelte",
		"angular"
	],
	"peerDependencies": {
		"@absolutejs/isolated-jsc": ">=0.12.2 <0.13.0",
		"@modelcontextprotocol/sdk": ">=1.29.0 <2",
		"@angular/core": ">=21.2.18 <22",
		"@elysiajs/cron": ">=1.4.2 <2",
		"drizzle-orm": ">=1.0.0-rc.4 <2",
		"elysia": ">=1.4.29 <2",
		"react": ">=19.2.8 <20",
		"svelte": ">=5.56.7 <6",
		"vue": ">=3.5.40 <4",
		"@tanstack/db": ">=0.6.16 <0.7"
	},
	"peerDependenciesMeta": {
		"@absolutejs/isolated-jsc": {
			"optional": true
		},
		"@modelcontextprotocol/sdk": {
			"optional": true
		},
		"@angular/core": {
