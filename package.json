{
	"name": "@absolutejs/sync",
	"version": "0.12.0",
	"description": "Lightweight reactive-push and write-behind-cache primitives for Elysia and the AbsoluteJS ecosystem — kill polling and keep a remote store off your hot path, without adopting a whole sync-engine backend.",
	"repository": {
		"type": "git",
		"url": "https://github.com/absolutejs/sync.git"
	},
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"license": "CC BY-NC 4.0",
	"author": "Alex Kahn",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./scheduled": {
			"types": "./dist/scheduled.d.ts",
			"import": "./dist/scheduled.js",
			"default": "./dist/scheduled.js"
		},
		"./client": {
			"types": "./dist/client/index.d.ts",
			"import": "./dist/client/index.js",
			"default": "./dist/client/index.js"
		},
		"./crdt": {
			"types": "./dist/crdt/index.d.ts",
			"import": "./dist/crdt/index.js",
			"default": "./dist/crdt/index.js"
		},
		"./drizzle": {
			"types": "./dist/adapters/drizzle/index.d.ts",
			"import": "./dist/adapters/drizzle/index.js",
			"default": "./dist/adapters/drizzle/index.js"
		},
		"./prisma": {
			"types": "./dist/adapters/prisma/index.d.ts",
			"import": "./dist/adapters/prisma/index.js",
			"default": "./dist/adapters/prisma/index.js"
		},
		"./engine": {
			"types": "./dist/engine/index.d.ts",
			"import": "./dist/engine/index.js",
			"default": "./dist/engine/index.js"
		},
		"./postgres": {
			"types": "./dist/adapters/postgres/index.d.ts",
			"import": "./dist/adapters/postgres/index.js",
			"default": "./dist/adapters/postgres/index.js"
		},
		"./mysql": {
			"types": "./dist/adapters/mysql/index.d.ts",
			"import": "./dist/adapters/mysql/index.js",
			"default": "./dist/adapters/mysql/index.js"
		},
		"./sqlite": {
			"types": "./dist/adapters/sqlite/index.d.ts",
			"import": "./dist/adapters/sqlite/index.js",
			"default": "./dist/adapters/sqlite/index.js"
		},
		"./react": {
			"types": "./dist/react/index.d.ts",
			"import": "./dist/react/index.js",
			"default": "./dist/react/index.js"
		},
		"./vue": {
			"types": "./dist/vue/index.d.ts",
			"import": "./dist/vue/index.js",
			"default": "./dist/vue/index.js"
		},
		"./svelte": {
			"types": "./dist/svelte/index.d.ts",
			"import": "./dist/svelte/index.js",
			"default": "./dist/svelte/index.js"
		},
		"./angular": {
			"types": "./dist/angular/index.d.ts",
			"import": "./dist/angular/index.js",
			"default": "./dist/angular/index.js"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "bun run scripts/build.ts",
		"config": "absolute config",
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"format": "prettier --write \"./**/*.{ts,json,md}\"",
		"release": "bun run format && bun run build && bun publish"
	},
	"keywords": [
		"absolutejs",
		"elysia",
		"reactive",
		"sse",
		"realtime",
		"write-behind",
		"cache",
		"sync",
		"drizzle",
		"prisma",
		"postgres",
		"mysql",
		"sqlite",
		"cdc",
		"react",
		"vue",
		"svelte",
		"angular"
	],
	"peerDependencies": {
		"@angular/core": ">= 21.0.0",
		"@elysiajs/cron": ">= 1.4.0",
		"drizzle-orm": ">= 0.44.0",
		"elysia": ">= 1.4.26",
		"react": ">= 19.0.0",
		"svelte": ">= 5.0.0",
		"vue": ">= 3.5.0"
	},
	"peerDependenciesMeta": {
		"@angular/core": {
			"optional": true
		},
		"@elysiajs/cron": {
			"optional": true
		},
		"drizzle-orm": {
			"optional": true
		},
		"elysia": {
			"optional": true
		},
		"react": {
			"optional": true
		},
		"svelte": {
			"optional": true
		},
		"vue": {
			"optional": true
		}
	},
	"devDependencies": {
		"@absolutejs/absolute": "^0.19.0-beta.1051",
		"@angular/core": "^21.0.0",
		"@elysiajs/cron": "^1.4.2",
		"@elysiajs/eden": "^1.4.9",
		"@types/bun": "latest",
		"@types/react": "^19.2.0",
		"drizzle-orm": "^0.45.2",
		"elysia": "latest",
		"prettier": "latest",
		"react": "^19.2.0",
		"svelte": "^5.55.0",
		"typescript": "latest",
		"vue": "^3.5.27"
	}
}
